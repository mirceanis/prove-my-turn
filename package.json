{
  "name": "zhuffle",
  "version": "0.1.5",
  "description": "Experiments in zk gaming",
  "author": "Mircea Nistor",
  "license": "Apache-2.0",
  "keywords": [
    "mina-zkapp",
    "mina-zk-app",
    "mina-dapp",
    "zkapp"
  ],
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "coverage": "yarn test --coverage",
    "format": "prettier --write --ignore-unknown **/*",
    "prepare": "husky install",
    "test": "node --experimental-vm-modules --experimental-wasm-modules --experimental-wasm-threads node_modules/jest/bin/jest.js",
    "testw": "node --experimental-vm-modules --experimental-wasm-modules --experimental-wasm-threads node_modules/jest/bin/jest.js --watch",
    "lint": "eslint --fix"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown"
    ],
    "src/**/*": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "6.9.1",
    "@typescript-eslint/parser": "6.9.1",
    "eslint": "8.53.0",
    "eslint-plugin-o1js": "0.4.0",
    "husky": "8.0.3",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^10.0.0",
    "@chainsafe/libp2p-noise": "^11.0.0",
    "@libp2p/bootstrap": "^9.0.0",
    "@libp2p/floodsub": "^8.0.0",
    "@libp2p/mdns": "^9.0.0",
    "@libp2p/mplex": "^8.0.0",
    "@libp2p/pubsub-peer-discovery": "^9.0.0",
    "@libp2p/tcp": "^8.0.0",
    "commander": "^14.0.2",
    "libp2p": "^0.42.0",
    "multiformats": "^12.0.0",
    "snarkyjs": "^0.7.1"
  }
}
